GOOGLE_API_KEY=your-gemini-api-key-here                     # required — your google gemini api key

LLM_MODEL=gemini-2.0-flash                                 # llm model for manager and marketer agents
IMAGE_MODEL=gemini-2.5-flash-image                          # image generation model

MANAGER_TEMPERATURE=0.4                                     # manager agent creativity (0.0 = strict, 1.0 = creative)
MARKETER_TEMPERATURE=0.7                                    # marketer agent creativity

HARD_SELL_THRESHOLD=3                                       # bikes scoring >= this are targeted by campaigns
AUTO_SELL_PROBABILITY=0.40                                  # chance a targeted bike sells after a campaign (0.0–1.0)
MAX_BIKES_PER_CAMPAIGN=10                                   # max bikes per campaign — caps api calls to avoid token limits
