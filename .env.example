# -- Required --
GOOGLE_API_KEY=your-gemini-api-key-here

# -- Models (override defaults) --
# LLM_MODEL=gemini-2.0-flash
# IMAGE_MODEL=gemini-2.5-flash-image

# -- Agent temperatures --
# MANAGER_TEMPERATURE=0.4
# MARKETER_TEMPERATURE=0.8

# -- Scoring --
# HARD_SELL_THRESHOLD=3
# SCORE_DECAY_PER_DAY=0.15
# AUTO_SELL_PROBABILITY=0.25

# -- Scheduler (seconds between loops; 300 = simulated 1 day) --
# LOOP_INTERVAL_SEC=300

# -- Paths --
# CSV_PATH=sample_data_movelo_links.csv
# TRIALS_LOG_PATH=trials_log.csv
# OUTPUT_DIR=output
